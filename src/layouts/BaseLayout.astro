---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';

interface Props {
  title: string;
  description?: string;
  lang: 'zh' | 'en';
  canonical?: string;
}

const { title, description, lang, canonical } = Astro.props;
const canonicalUrl = new URL(canonical ?? Astro.url.pathname, Astro.site).toString();
const footerCopy = lang === 'zh'
  ? '个人网站 · 风险智能 · 图机器学习 · 多模态 AI'
  : 'Personal site · Risk intelligence · Graph ML · Multimodal AI';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description ?? title} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    <SiteHeader lang={lang} />
    <main class="site-main"><slot /></main>
    <footer class="site-footer"><div class="shell">© {new Date().getFullYear()} · {footerCopy}</div></footer>
  </body>
</html>

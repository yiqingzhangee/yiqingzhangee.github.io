---
import ArticleList from '../../../components/ArticleList.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getWriting, type Locale } from '../../../lib/content';

export function getStaticPaths() {
  return ['zh', 'en'].map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
if (lang !== 'zh' && lang !== 'en') return Astro.redirect('/');
const writing = await getWriting(lang);
const title = lang === 'zh' ? '写作' : 'Writing';
const lede = lang === 'zh'
  ? '技术文章、研究综述与工作笔记。'
  : 'Technical writing, research reviews, and notes from practice.';
---

<BaseLayout title={title} description={lede} lang={lang}>
  <section class="page">
    <p class="kicker">{lang === 'zh' ? '知识库' : 'Notebook'}</p>
    <h1 class="page-title">{title}</h1>
    <p class="page-lede">{lede}</p>
    <ArticleList entries={writing} lang={lang} />
  </section>
</BaseLayout>

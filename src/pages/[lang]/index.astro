---
import HomePage from '../../components/HomePage.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { profileByLocale, type Locale } from '../../data/profile';

export function getStaticPaths() {
  return ['zh', 'en'].map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
if (lang !== 'zh' && lang !== 'en') return Astro.redirect('/');
const profile = profileByLocale[lang];
---

<BaseLayout title={`${profile.displayName} | ${profile.role}`} description={profile.intro} lang={lang}>
  <HomePage lang={lang} />
</BaseLayout>

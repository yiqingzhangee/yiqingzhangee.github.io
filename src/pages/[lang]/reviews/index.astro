---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getArticles, type Locale } from '../../../lib/content';
export function getStaticPaths() {
  return ['zh', 'en'].map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Locale;
if (lang !== 'zh' && lang !== 'en') return Astro.redirect('/');
const reviews = await getArticles('reviews', lang);
const title = lang === 'zh' ? '综述与笔记' : 'Reviews & notes';
---
<BaseLayout title={title} lang={lang}>
  <section class="page">
    <p class="kicker">{lang === 'zh' ? '慢读' : 'Slow reading'}</p>
    <h1 class="page-title">{title}</h1>
    <p class="page-lede">{lang === 'zh' ? '对论文、工具与开源项目的结构化理解。' : 'Structured notes on papers, tools, and open-source projects.'}</p>
    <ul class="article-list">
      {reviews.map((review) => <li><a href={`/${lang}/reviews/${review.id.replace(`${lang}/`, '')}/`}><span class="article-meta">{review.data.date.toLocaleDateString()}</span><h2>{review.data.title}</h2><span class="article-type">{review.data.tags[0] ?? 'Review'}</span></a></li>)}
    </ul>
  </section>
</BaseLayout>
